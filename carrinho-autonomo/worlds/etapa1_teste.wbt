  basicTimeStep 32
  contactProperties [
    ContactProperties {
      material1 "apoio"
      coulombFriction [ 0.001 ]
    }
  ]
}
Viewpoint {
  orientation -0.257142 0.620796 0.740602 1.019900
  position -1.2 -1.2 1.4
}
Background { skyColor [ 0.70 0.80 0.90 ] }
DirectionalLight { direction -0.5 0.3 -1 intensity 1 }
Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.58 0.60 roughness 1 metalness 0 }
      geometry DEF PISO Box { size 6 6 0.1 }
    }
  ]
  name "piso"
  boundingObject USE PISO
}
Carrinho {
